option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "mysite.settings"
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
    DJANGO_DEBUG: "False"
    DJANGO_ALLOWED_HOSTS: ".elasticbeanstalk.com;localhost;127.0.0.1"
    DJANGO_DATABASE_PATH: "/var/app/data/db.sqlite3"
    DJANGO_SECRET_KEY_FILE: "/var/app/data/django-secret-key"
  aws:elasticbeanstalk:container:python:
    WSGIPath: mysite.wsgi:application

commands:
  01_persistent_data:
    command: "install -d -m 700 -o webapp -g webapp /var/app/data"
  02_secret_key:
    command: |
      python3 - <<'PY'
      import os
      import pwd
      import secrets
      from pathlib import Path
      path = Path('/var/app/data/django-secret-key')
      if not path.exists():
          fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
          with os.fdopen(fd, 'w') as secret_file:
              secret_file.write(secrets.token_urlsafe(64))
          user = pwd.getpwnam('webapp')
          os.chown(path, user.pw_uid, user.pw_gid)
      PY

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && runuser -u webapp --preserve-environment -- python manage.py migrate --noinput"
    leader_only: true
  02_seed_polls:
    command: "source /var/app/venv/*/bin/activate && runuser -u webapp --preserve-environment -- python manage.py seed_polls"
    leader_only: true
  03_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
